package teammanagement;

public class Warrior extends GameCharacter implements Attacker {
    private int armor;

    public Warrior(String name, int level, int health, int maxHealth, int armor) {
        super(name, level, health, maxHealth);
        this.armor = armor;
    }

    public int getArmor() { return armor; }
    public void setArmor(int armor) { this.armor = armor; }

    @Override
    public void getCharacterInfo() {
        System.out.println("Warrior: " + getName() + " | Level: " + getLevel()
                + " | Health: " + getHealth() + "/" + getMaxHealth() + " | Armor: " + armor);
    }

    @Override
    public int calculatePower() {
        return getLevel() * 10 + this.armor * 2;
    }

    @Override
    public int takeDamage(int damage) {
        int reducedDamage = damage - (this.armor / 2);
        if (reducedDamage < 1) {
            reducedDamage = 1;
        }
        return super.takeDamage(reducedDamage);
    }

    @Override
    public int attack(GameCharacter target) {
        int damage = calculatePower() / 4;
        target.takeDamage(damage);
        return damage;
    }
}
