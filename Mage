package teammanagement;

public class Mage extends GameCharacter implements Supporter, Attacker {
    private int mana;

    public Mage(String name, int level, int health, int maxHealth, int mana) {
        super(name, level, health, maxHealth);
        this.mana = mana;
    }

    public int getMana() { return mana; }
    public void setMana(int mana) { this.mana = mana; }

    @Override
    public void getCharacterInfo() {
        System.out.println("Mage: " + getName() + " | Level: " + getLevel()
                + " | Health: " + getHealth() + "/" + getMaxHealth() + " | Mana: " + mana);
    }

    @Override
    public int calculatePower() {
        return getLevel() * 8 + this.mana;
    }

    @Override
    public int attack(GameCharacter target) {
        if (this.mana < 20) {
            System.out.println(getName() + " does not have enough mana to attack.");
            return 0;
        }
        int damage = calculatePower() / 3;
        this.mana -= 20;
        target.takeDamage(damage);
        return damage;
    }

    @Override
    public int heal(GameCharacter target) {
        if (this.mana < 15) {
            System.out.println(getName() + " does not have enough mana to heal.");
            return 0;
        }
        this.mana -= 15;
        int healAmount = getLevel() * 2;
        target.restoreHealth(healAmount);
        return healAmount;
    }
}
